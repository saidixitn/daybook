{
  "version": 2,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/signup", "destination": "/signup.html" },
    { "source": "/onboarding", "destination": "/onboarding.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/schedule", "destination": "/app/schedule.html" },
    { "source": "/app/tasks", "destination": "/app/tasks.html" },
    { "source": "/app/insights", "destination": "/app/insights.html" },
    { "source": "/app/settings", "destination": "/app/settings.html" }
  ],
  "redirects": [
    { "source": "/login.html", "destination": "/login", "permanent": true },
    { "source": "/signup.html", "destination": "/signup", "permanent": true },
    { "source": "/onboarding.html", "destination": "/onboarding", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/app.html", "destination": "/app", "permanent": true },
    { "source": "/app/index.html", "destination": "/app", "permanent": true },
    { "source": "/app/index", "destination": "/app", "permanent": true },
    { "source": "/app/", "destination": "/app", "permanent": true },
    { "source": "/app/schedule.html", "destination": "/app/schedule", "permanent": true },
    { "source": "/app/tasks.html", "destination": "/app/tasks", "permanent": true },
    { "source": "/app/insights.html", "destination": "/app/insights", "permanent": true },
    { "source": "/app/settings.html", "destination": "/app/settings", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
